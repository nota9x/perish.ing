---
import { Camera, Heart } from '@lucide/astro';
import { slide } from 'astro:transitions';
import BackRow from '../components/BackRow.astro';
import { siteConfig } from '../data/site';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const structuredData = [
  {
    '@type': 'AboutPage',
    '@id': `${siteConfig.url}/about/#about`,
    url: `${siteConfig.url}/about/`,
    name: 'About a9x',
    description:
      'A short personal note from a9x about new jersey, cats, urbexing, and wanting to be friends.',
    mainEntity: {
      '@id': `${siteConfig.url}#person`,
    },
  },
];
---

<Layout
  title="about | a9x"
  description="A short personal note from a9x about new jersey, cats, urbexing, and wanting to be friends."
  pageType="AboutPage"
  ogType="profile"
  structuredData={structuredData}
>
  <article
    class="page page--interior"
    transition:name="page"
    transition:animate={slide({ duration: '0.28s' })}
    tabindex="-1"
    data-page
  >
    <div class="page-header">
      <h1 class="page-title" transition:name="about-title">about</h1>
      <p class="page-subtitle">a little bit about me</p>
    </div>

    <div class="about-hero-quote" aria-label="Opening quote">
      <div class="about-hero-quote__mark" aria-hidden="true">&ldquo;</div>
      <blockquote class="about-hero-quote__text">
        Even after all this time, the sun never says to the earth &lsquo;you owe me.&rsquo; Look
        what happens with a love like that — it lights the whole sky.
      </blockquote>
      <cite class="about-hero-quote__attribution">— Hafiz</cite>
    </div>

    <section class="about-section" aria-label="About me">
      <div class="about-section__header">
        <span class="about-section__icon" aria-hidden="true"><Heart /></span>
        <h2 class="about-section__title">hi</h2>
      </div>

      <div class="about-divider" aria-hidden="true">
        <span class="about-divider__line"></span>
      </div>

      <div class="about-section__body">
        <p>hi, i'm a teenager from new jersey. i like cats, the color black, and you!</p>
        <p>
          my favorite hobby is urbexing. check out my <a
            href="https://www.instagram.com/urb.exnj/"
            target="_blank"
            rel="noreferrer">ig</a
          >; i've got a lot of cool photos there and hope to post more soon!
        </p>

        <div class="about-callout">
          <span class="about-callout__bar" aria-hidden="true"></span>
          <p class="about-callout__text">
            i aspire to be a part of new jersey's finest in the near future, or in other terms, an
            armed marriage counselor. maybe i'll put some stories here whenever that happens.
          </p>
        </div>

        <p>
          want to be friends? <a href="/contact">come say hi.</a>
        </p>
      </div>
    </section>

    <section class="about-section" aria-label="Urbex photos">
      <div class="about-section__header">
        <span class="about-section__icon" aria-hidden="true"><Camera /></span>
        <h2 class="about-section__title">photos</h2>
      </div>

      <div class="about-divider" aria-hidden="true">
        <span class="about-divider__line"></span>
      </div>

      <div class="about-section__body">
        <p>
          i post urbex photos at <a
            href="https://www.instagram.com/urb.exnj/"
            target="_blank"
            rel="noreferrer">@urb.exnj</a
          >.
        </p>
      </div>
    </section>

    <footer class="page-footer">
      <BackRow href="/" label="back" />
    </footer>
  </article>
</Layout>
